# ===== BLACK HORNET MD — environment configuration =====
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Identity ---
BOT_NAME=BLACK HORNET MD
PREFIX=.

# --- Owner / authorized testers ---
# Your own WhatsApp number (digits only, with country code, no '+').
OWNER_1=255700000000
# Optional second owner/admin number.
OWNER_2=

# Comma-separated list of numbers explicitly authorized for controlled
# research/testing exchanges between your own devices (digits only).
# Owners are always implicitly authorized; you don't need to repeat them here.
AUTHORIZED_TEST_NUMBERS=255700000000,255711111111

# --- Session ---
# Where Baileys stores WhatsApp Web auth state. Defaults to ./storage/session.
# SESSION_FOLDER=./storage/session

# Portable session (optional). Leave blank for a first run — the bot will
# show a QR (terminal + pairing website) to log in. Once connected, the
# console and the pairing website print a SESSION_ID string; paste it here
# (or into your host's env var panel) so a redeploy with wiped disk doesn't
# need a fresh QR scan. Keep this secret — it's equivalent to your WhatsApp login.
SESSION_ID=

# Port for the pairing website (QR code + SESSION_ID display). Most hosting
# panels (Katabump and similar) set PORT automatically — only change this
# for local use if 3000 is taken.
PORT=3000

# --- Blue Team thresholds (sane defaults shown; override only if needed) ---
BT_MAX_TEXT_LENGTH=4000
BT_MAX_VCARD_LENGTH=3000
BT_MAX_VCARD_COUNT=50
BT_MAX_MENTIONS=15
BT_MAX_REPEATED_CHAR=500
BT_MAX_INVISIBLE_CHARS=200
BT_SPAM_WINDOW_MS=8000
BT_SPAM_MAX_MESSAGES=6
BT_COMMAND_COOLDOWN_MS=1200
BT_STRIKE_WARN_AT=3
BT_STRIKE_MUTE_AT=5
BT_STRIKE_MUTE_MINUTES=10
BT_STRIKE_BLACKLIST_AT=9

# --- System Monitor thresholds ---
MON_SAMPLE_INTERVAL_MS=30000
MON_EVENTLOOP_WARN_MS=150
MON_MEMORY_WARN_MB=400
MON_HISTORY_SIZE=200

# --- Reporting ---
REPORT_MAX_EVENTS=2000

# --- Logging ---
LOG_LEVEL=info
